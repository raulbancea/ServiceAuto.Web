<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ServiceAuto.Web</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">ServiceAuto</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">

                <!-- LEFT MENU -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Clients/Index">Clienți</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Masini/Index">Mașini</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/PieseDeSchimb/Index">Piese</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Interventii/Index">Intervenții</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/InterventiePiese/Index">
                            Piese în intervenții
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-page="/Mecanici/Index">
                                Mecanici
                            </a>
                        </li>
                    }
                </ul>

                <!-- RIGHT MENU -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span class="nav-link text-muted">
                            @User.Identity.Name
                            (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-danger" asp-page="/Logout">Logout</a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
