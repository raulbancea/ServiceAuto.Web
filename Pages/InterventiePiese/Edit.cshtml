@page
@model ServiceAuto.Web.Pages.InterventiePiese.EditModel

<h1>Edit</h1>

<h4>Interventie Piesa</h4>
<hr />

<form method="post">
    <input type="hidden" asp-for="InterventiePiesa.InterventieId" />
    <input type="hidden" asp-for="InterventiePiesa.PiesaDeSchimbId" />

    <div class="form-group">
        <label>Cantitate</label>
        <input asp-for="InterventiePiesa.Cantitate" class="form-control" />
    </div>

    <div class="form-group">
        <label>Pret unitar</label>
        <input asp-for="InterventiePiesa.PretUnitarLaDataAplicarii" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</form>
