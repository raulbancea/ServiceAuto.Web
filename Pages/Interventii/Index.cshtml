@page
@model ServiceAuto.Web.Pages.Interventii.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].DataProgramare)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].DescriereProblema)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].ObservatiiMecanic)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].Masina)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Interventie[0].Mecanic)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Interventie) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataProgramare)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DescriereProblema)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ObservatiiMecanic)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Masina.Marca)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mecanic.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.InterventieId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.InterventieId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.InterventieId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
